# Control-plane API
YUNPANEL_API_HOST=127.0.0.1
YUNPANEL_API_PORT=3001
YUNPANEL_SERVER_STORE=.data/server-registry.json
YUNPANEL_DOMAIN_STORE=.data/domain-registry.json
YUNPANEL_JOB_STORE=.data/job-registry.json
YUNPANEL_CERTIFICATE_STORE=.data/certificate-registry.json
YUNPANEL_APPLICATION_STORE=.data/application-registry.json
YUNPANEL_APPLICATION_ENVIRONMENT_STORE=.data/application-environment-registry.json

# Agentless local execution is disabled while this is empty. On packaged hosts,
# set only the exact server UUID printed by the guarded local-runtime `create`
# (fresh agentless host) or `bind` (existing enrolled host) command after API+agent
# are stopped, queue/recovery is clear and the required verified --backup-dir gate
# succeeds. Keep production state under /var/lib/yunpanel/control-plane.
YUNPANEL_LOCAL_SERVER_ID=

# One 32-byte root key, encoded as 64 hex characters or base64, protects both
# application secret environment values and MFA secrets. Keep the SAME value across
# upgrades. Do not rotate it by editing this variable alone; use docs/secret-master-key-rotation.md.
YUNPANEL_SECRET_MASTER_KEY=

# Certificate renewal scheduler defaults: every 6 hours, renew within 30 days of expiry.
YUNPANEL_CERTIFICATE_RENEWAL_INTERVAL_MS=21600000
YUNPANEL_CERTIFICATE_RENEW_BEFORE_MS=2592000000

# User authentication. Configure the same EXACT origin in API and web gateway environments.
# Production requires HTTPS, no trailing slash. Loopback HTTP is development-only.
YUNPANEL_PUBLIC_ORIGIN=http://127.0.0.1:5173
# Optional absolute override; default is auth/auth.sqlite alongside YUNPANEL_SERVER_STORE.
# The directory must be service-owned mode 0700 and the database mode 0600.
# Packaged service permits writes beneath /var/lib/yunpanel/control-plane.
# YUNPANEL_AUTH_DB=/var/lib/yunpanel/control-plane/auth/auth.sqlite
# Keep the existing web-gateway IP allowlist until the remaining security release gate is satisfied.
# YUNPANEL_ALLOWED_CLIENT_IPS=<approved client addresses>
# No shared admin bootstrap bearer token is accepted by the deployed management API.
# Create the first Owner with the local CLI; see docs/authentication.md.

# Retained legacy yun-agent daemon settings. Fresh agentless installs do not need these.
YUN_AGENT_HOST=127.0.0.1
YUN_AGENT_PORT=4010
YUN_AGENT_MODE=development

# Set an explicit random token only when exercising the retained legacy agent daemon.
# Production must never use the development fallback token.
YUN_AGENT_TOKEN=

# Optional retained legacy agent -> control-plane heartbeat/command link for an
# already-enrolled rollback identity. New enrollment is retired; an explicit
# root-protected identity file is required when this compatibility link is enabled.
YUNPANEL_CONTROL_PLANE_URL=
YUN_AGENT_IDENTITY_FILE=
YUN_AGENT_HEARTBEAT_MS=30000
YUN_AGENT_COMMAND_POLL_MS=5000
