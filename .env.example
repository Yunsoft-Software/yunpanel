# Control-plane API
YUNPANEL_API_HOST=127.0.0.1
YUNPANEL_API_PORT=3001

# yun-agent
YUN_AGENT_HOST=127.0.0.1
YUN_AGENT_PORT=4010
YUN_AGENT_URL=http://127.0.0.1:4010
YUN_AGENT_MODE=development

# Set an explicit random token when testing authentication behavior.
# Production must never use the development fallback token.
YUN_AGENT_TOKEN=
