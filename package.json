{
  "name": "yunpanel",
  "version": "0.3.0",
  "private": true,
  "description": "Yunsoft-focused hosting and server management panel",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.11.1",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "npm run dev --workspace @yunpanel/web",
    "dev:api": "npm run dev --workspace @yunpanel/api",
    "dev:agent": "npm run dev --workspace @yunpanel/agent",
    "auth": "npm run auth --workspace @yunpanel/api --",
    "secret-key": "node scripts/rotate-secret-master-key.mjs",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "node scripts/validate-repository.mjs",
    "check": "npm run lint && npm test && npm run build"
  }
}
