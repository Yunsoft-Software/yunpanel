#!/bin/sh
set -eu

if ! getent group yunpanel >/dev/null; then
  addgroup --system yunpanel >/dev/null
fi
if ! id yunpanel >/dev/null 2>&1; then
  adduser --system --ingroup yunpanel --home /var/lib/yunpanel --no-create-home yunpanel >/dev/null
fi

install -d -o yunpanel -g yunpanel -m 0700 /var/lib/yunpanel/control-plane
install -d -o root -g root -m 0700 /var/lib/yunpanel/agent
install -d -o yunpanel -g yunpanel -m 0700 /etc/yunpanel/control-plane
install -d -o root -g root -m 0700 /etc/yunpanel/agent
install -d -o yunpanel -g yunpanel -m 0700 /etc/yunpanel/web

proxy_env=/etc/yunpanel/control-plane/proxy.env
proxy_token_count=0
if [ -f "$proxy_env" ]; then
  proxy_token_count=$(grep -Ec '^YUNPANEL_INTERNAL_PROXY_TOKEN=' "$proxy_env" || true)
fi
if [ "$proxy_token_count" -ne 1 ] || ! grep -Eq '^YUNPANEL_INTERNAL_PROXY_TOKEN=[A-Za-z0-9_-]{43}$' "$proxy_env" 2>/dev/null; then
  proxy_token=$(/usr/local/bin/node --input-type=module -e 'import { randomBytes } from "node:crypto"; process.stdout.write(randomBytes(32).toString("base64url"));')
  proxy_temp=$(mktemp /etc/yunpanel/control-plane/proxy.env.XXXXXX)
  if [ -f "$proxy_env" ]; then
    grep -v '^YUNPANEL_INTERNAL_PROXY_TOKEN=' "$proxy_env" >"$proxy_temp" || true
  fi
  printf 'YUNPANEL_INTERNAL_PROXY_TOKEN=%s\n' "$proxy_token" >>"$proxy_temp"
  install -o root -g root -m 0600 "$proxy_temp" "$proxy_env"
  rm -f "$proxy_temp"
fi

api_env=/etc/yunpanel/control-plane/api.env
if [ -f "$api_env" ] && ! grep -q '^YUNPANEL_MAILBOX_STORE=' "$api_env"; then
  api_temp=$(mktemp /etc/yunpanel/control-plane/api.env.XXXXXX)
  cp "$api_env" "$api_temp"
  printf '%s\n' 'YUNPANEL_MAILBOX_STORE=/var/lib/yunpanel/control-plane/mailbox-registry.json' >>"$api_temp"
  install -o yunpanel -g yunpanel -m 0600 "$api_temp" "$api_env"
  rm -f "$api_temp"
fi

if command -v systemctl >/dev/null 2>&1; then
  systemctl daemon-reload || true
  systemctl enable yunpanel-api.service yunpanel-web.service >/dev/null 2>&1 || true
  if [ -z "${2:-}" ]; then
    if [ -f /etc/yunpanel/agent/agent.env ]; then
      systemctl enable yun-agent.service >/dev/null 2>&1 || true
    fi
    [ -f /etc/yunpanel/control-plane/api.env ] && systemctl start yunpanel-api.service || true
    [ -f /etc/yunpanel/agent/agent.env ] && systemctl start yun-agent.service || true
    [ -f /etc/yunpanel/web/web.env ] && systemctl start yunpanel-web.service || true
  fi
fi

exit 0
