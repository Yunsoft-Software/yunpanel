[Unit]
Description=YunPanel privileged local management API
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/usr/lib/yunpanel
EnvironmentFile=/etc/yunpanel/control-plane/api.env
EnvironmentFile=/etc/yunpanel/control-plane/proxy.env
ExecStart=/usr/local/bin/node apps/api/src/index.js
Restart=on-failure
RestartSec=3
UMask=0077

[Install]
WantedBy=multi-user.target
