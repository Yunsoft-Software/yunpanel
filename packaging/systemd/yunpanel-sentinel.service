[Unit]
Description=YunPanel outage alert check, independent of the panel API
After=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/usr/lib/yunpanel
EnvironmentFile=/etc/yunpanel/control-plane/api.env
EnvironmentFile=-/etc/yunpanel/web/web.env
UnsetEnvironment=YUNPANEL_SECRET_MASTER_KEY
ExecStart=/usr/local/bin/node apps/api/src/notification-sentinel.js
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/yunpanel/control-plane
