[Unit]
Description=YunPanel restricted web dashboard
Wants=network-online.target yunpanel-api.service
After=network-online.target yunpanel-api.service

[Service]
Type=simple
User=yunpanel
Group=yunpanel
WorkingDirectory=/usr/lib/yunpanel
EnvironmentFile=/etc/yunpanel/control-plane/proxy.env
EnvironmentFile=/etc/yunpanel/web/web.env
UnsetEnvironment=YUNPANEL_SECRET_MASTER_KEY YUNPANEL_AUTH_DB YUNPANEL_SERVER_STORE YUNPANEL_DOMAIN_STORE YUNPANEL_JOB_STORE YUNPANEL_BACKUP_OPERATION_STORE YUNPANEL_CERTIFICATE_STORE YUNPANEL_APPLICATION_STORE YUNPANEL_WEBSITE_STORE YUNPANEL_WEBSITE_MIGRATION_POLICY_STORE YUNPANEL_WEBSITE_MIGRATION_LEDGER_STORE YUNPANEL_DNS_HOSTING_STORE YUNPANEL_DNS_CREDENTIAL_STORE YUNPANEL_MAIL_DOMAIN_STORE YUNPANEL_MAILBOX_STORE YUNPANEL_MAILBOX_QUOTA_STORE YUNPANEL_MAILBOX_FORWARDING_STORE YUNPANEL_MAIL_ALIAS_STORE YUNPANEL_MAIL_DKIM_ROOT YUNPANEL_MAIL_DKIM_RETIREMENT_STORE YUNPANEL_MAIL_SERVICE_IDENTITY_STORE YUNPANEL_MAIL_SRS_SECRET_STORE YUNPANEL_ROUNDCUBE_SECRET_STORE YUNPANEL_DATABASE_BINDING_STORE YUNPANEL_DATABASE_CREDENTIAL_STORE YUNPANEL_DOCKER_WORKLOAD_STORE YUNPANEL_DOCKER_COMPOSE_PROJECT_STORE YUNPANEL_DOCKER_COMPOSE_ENVIRONMENT_STORE YUNPANEL_DOCKER_REGISTRY_CREDENTIAL_STORE YUNPANEL_APPLICATION_ENVIRONMENT_STORE YUNPANEL_LOCAL_SERVER_ID YUN_AGENT_TOKEN
ExecStart=/usr/local/bin/node apps/web/server.js
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
InaccessiblePaths=/etc/yunpanel/control-plane /var/lib/yunpanel/control-plane
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
