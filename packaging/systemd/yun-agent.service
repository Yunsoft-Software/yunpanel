[Unit]
Description=YunPanel privileged agent
Wants=network-online.target yunpanel-api.service
After=network-online.target yunpanel-api.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/usr/lib/yunpanel
EnvironmentFile=/etc/yunpanel/agent/agent.env
ExecStart=/usr/local/bin/node apps/agent/src/index.js
Restart=on-failure
RestartSec=3
UMask=0077
PrivateTmp=true
ProtectHome=true

[Install]
WantedBy=multi-user.target
